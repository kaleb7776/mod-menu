                            pickerFrame.Visible = isOpen
                            Tween(pickerFrame, 0.2, {Size = isOpen and UDim2.new(1, 0, 0, 110) or UDim2.new(1, 0, 0, 0)})
                            colorFrame.Size = UDim2.new(1, 0, 0, isOpen and 144 or 30)
                        end)
                    end
                end)
                if flag then Library.Flags[flag] = color end
                return { Set = function(newColor) hue, saturation, value = newColor:ToHSV(); if saturationValueCursor then saturationValueCursor.Position = UDim2.new(saturation, 0, 1 - value, 0) end; if hueCursor then hueCursor.Position = UDim2.new(0.5, 0, hue, 0) end; UpdateColor() end, Get = function() return color end }
            end
            
            return sectionObject
        end
        
        return tabObject
    end
    
    return windowObject
end

return Library
