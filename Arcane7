                    isOpen = not isOpen
                    if isOpen then
                        pcall(function() ddList.Visible = true end)
                        local h = math.min(#options * 26 + 6, 130)
                        Tween(ddList, 0.2, { Size = UDim2.new(1, 0, 0, h) })
                        Tween(arrowLabel, 0.2, { Rotation = 180 })
                        ddFrame.Size = UDim2.new(1, 0, 0, 52 + h)
                    else
                        Tween(ddList, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
                        Tween(arrowLabel, 0.2, { Rotation = 0 })
                        task.delay(0.2, function() pcall(function() ddList.Visible = false end) end)
                        ddFrame.Size = UDim2.new(1, 0, 0, 48)
                    end
                end)
                SafeConnect(ddButton.MouseEnter, function() Tween(ddButton, 0.15, { BackgroundColor3 = Theme.ElementHover }) end)
                SafeConnect(ddButton.MouseLeave, function() Tween(ddButton, 0.15, { BackgroundColor3 = Theme.Element }) end)

                if flag then Library.Flags[flag] = selected end

                local obj = {}
                function obj:Set(v)
                    selected = v
                    pcall(function() selectedLabel.Text = tostring(v) end)
                    if flag then Library.Flags[flag] = selected end
                    RefreshOptions()
                end
                function obj:Get() return selected end
                function obj:Refresh(newOptions)
                    if type(newOptions) == "table" then options = newOptions; RefreshOptions() end
                end
                return obj
            end

            -- KEYBIND
            function sectionObject:AddKeybind(text, defaultKey, flag, callback, hold)
                defaultKey = defaultKey or Enum.KeyCode.None
                callback = callback or function() end
                hold = hold == true
                local key = defaultKey
                local isListening = false
                local isHolding = false
                local holdConn = nil

                local kbFrame = SafeNew("TextButton", {
                    Name = "Keybind",
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = Theme.Element,
                    Text = "", AutoButtonColor = false,
                    Parent = contentContainer,
                })
                if not kbFrame then return nil end
                AddCorner(kbFrame, 6)

                SafeNew("TextLabel", {
                    Name = "Label",
                    Size = UDim2.new(1, -70, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(text or "Keybind"),
                    TextColor3 = Theme.Text, TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = kbFrame,
                })

                local keyLabel = SafeNew("TextLabel", {
                    Name = "Key",
                    Size = UDim2.new(0, 55, 0, 20),
                    Position = UDim2.new(1, -60, 0.5, -10),
                    BackgroundColor3 = Theme.SliderBg,
                    Text = (tostring(key) == "Enum.KeyCode.None" and "..." or tostring(key):gsub("Enum.KeyCode.", "")),
                    TextColor3 = Theme.Accent, TextSize = 11,
                    Font = Enum.Font.GothamBold, Parent = kbFrame,
                })
                AddCorner(keyLabel, 4)

                SafeConnect(kbFrame.MouseButton1Click, function()
                    if isListening then return end
                    isListening = true
                    pcall(function()
                        keyLabel.Text = "..."
                        Tween(keyLabel, 0.15, { BackgroundColor3 = Theme.Accent })
                        keyLabel.TextColor3 = Color3.new(1, 1, 1)
                    end)
                    local conn
                    conn = SafeConnect(UserInputService.InputBegan, function(input)
                        if not input then return end
                        local isKb = input.UserInputType == Enum.UserInputType.Keyboard
                        local isMb = input.UserInputType == Enum.UserInputType.MouseButton1
                            or input.UserInputType == Enum.UserInputType.MouseButton2
                            or input.UserInputType == Enum.UserInputType.MouseButton3
                        if isKb or isMb then
                            key = isKb and input.KeyCode or input.UserInputType
                            pcall(function()
                                keyLabel.Text = tostring(key):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
                                Tween(keyLabel, 0.15, { BackgroundColor3 = Theme.SliderBg })
                                keyLabel.TextColor3 = Theme.Accent
                            end)
                            if flag then Library.Flags[flag] = key end
                            isListening = false
                            if conn then pcall(function() conn:Disconnect() end) end
                        end
                    end)
                end)

                SafeConnect(kbFrame.MouseEnter, function() Tween(kbFrame, 0.15, { BackgroundColor3 = Theme.ElementHover }) end)
                SafeConnect(kbFrame.MouseLeave, function() Tween(kbFrame, 0.15, { BackgroundColor3 = Theme.Element }) end)

                -- Hold
                SafeConnect(UserInputService.InputBegan, function(input, gameProcessed)
                    if gameProcessed or isListening or not input then return end
                    local inKey = (input.UserInputType == Enum.UserInputType.Keyboard)
                        and input.KeyCode or input.UserInputType
                    if inKey == key then
                        if hold then
                            isHolding = true
                            if holdConn then pcall(function() holdConn:Disconnect() end) end
                            holdConn = SafeConnect(RunService.Heartbeat, function()
                                if isHolding then SafeCall(callback) end
                            end)
                        else
                            SafeCall(callback)
                        end
                    end
                end)
                SafeConnect(UserInputService.InputEnded, function(input, gameProcessed)
                    if gameProcessed or not input then return end
                    local inKey = (input.UserInputType == Enum.UserInputType.Keyboard)
                        and input.KeyCode or input.UserInputType
                    if inKey == key and hold then
                        isHolding = false
                        if holdConn then
                            pcall(function() holdConn:Disconnect() end)
                            holdConn = nil
                        end
                    end
                end)

                if flag then Library.Flags[flag] = key end

                local obj = {}
                function obj:Set(k)
                    key = k
                    pcall(function()
                        keyLabel.Text = (tostring(key) == "Enum.KeyCode.None")
                            and "..." or tostring(key):gsub("Enum.KeyCode.", "")
                    end)
                    if flag then Library.Flags[flag] = key end
                end
                function obj:Get() return key end
                return obj
            end

            -- COLOR PICKER (com SafeDivide em toda divisão)
            function sectionObject:AddColorPicker(text, defaultColor, flag, callback)
                defaultColor = (typeof(defaultColor) == "Color3") and defaultColor or Color3.fromRGB(255, 255, 255)
                callback = callback or function() end
                local hue, saturation, value = defaultColor:ToHSV()
                local color = defaultColor
                local isOpen = false

                local colorFrame = SafeNew("Frame", {
                    Name = "ColorPicker",
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundTransparency = 1,
                    ClipsDescendants = false, Parent = contentContainer,
                })
                if not colorFrame then return nil end

                SafeNew("TextLabel", {
                    Name = "Label",
                    Size = UDim2.new(1, -45, 1, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(text or "Color"),
                    TextColor3 = Theme.Text, TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = colorFrame,
                })

                local colorButton = SafeNew("TextButton", {
                    Name = "ColorButton",
                    Size = UDim2.new(0, 35, 0, 22),
                    Position = UDim2.new(1, -37, 0.5, -11),
                    BackgroundColor3 = color,
                    Text = "", Parent = colorFrame,
                })
                AddCorner(colorButton, 4)
                AddStroke(colorButton, Theme.Border)

                local pickerFrame = SafeNew("Frame", {
                    Name = "Picker",
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Theme.Section,
                    ClipsDescendants = true, Visible = false,
                    ZIndex = 30, BorderSizePixel = 0, Parent = colorFrame,
                })
                AddCorner(pickerFrame, 8)
                AddStroke(pickerFrame, Theme.Border)

                local svMap = SafeNew("ImageButton", {
                    Name = "SVMap",
                    Size = UDim2.new(0, 120, 0, 90),
                    Position = UDim2.new(0, 10, 0, 10),
                    BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
                    Image = "rbxassetid://4155801252",
                    AutoButtonColor = false, ZIndex = 31, Parent = pickerFrame,
                })
                AddCorner(svMap, 4)

                local svCursor = SafeNew("Frame", {
                    Name = "Cursor",
                    Size = UDim2.new(0, 8, 0, 8),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(saturation, 0, 1 - value, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex = 32, BorderSizePixel = 0, Parent = svMap,
                })
                AddCorner(svCursor, 4)
                AddStroke(svCursor, Color3.new(0, 0, 0), 1)

                local hueBar = SafeNew("ImageButton", {
                    Name = "HueBar",
                    Size = UDim2.new(0, 18, 0, 90),
                    Position = UDim2.new(0, 140, 0, 10),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    AutoButtonColor = false, ZIndex = 31, Parent = pickerFrame,
                })
                AddCorner(hueBar, 4)
                SafeNew("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                        ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
                        ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                        ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
                        ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
                    }),
                    Parent = hueBar,
                })

                local hueCursor = SafeNew("Frame", {
                    Name = "Cursor",
                    Size = UDim2.new(1, 4, 0, 4),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, hue, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex = 32, BorderSizePixel = 0, Parent = hueBar,
                })
                AddCorner(hueCursor, 2)
                AddStroke(hueCursor, Color3.new(0, 0, 0), 1)

                local function UpdateColor()
                    color = Color3.fromHSV(
                        SafeClamp(hue, 0, 1),
                        SafeClamp(saturation, 0, 1),
                        SafeClamp(value, 0, 1)
                    )
                    pcall(function() colorButton.BackgroundColor3 = color end)
                    pcall(function() svMap.BackgroundColor3 = Color3.fromHSV(SafeClamp(hue, 0, 1), 1, 1) end)
                    if flag then Library.Flags[flag] = color end
                    SafeCall(callback, color)
                end

                local dragSV, dragHue = false, false
                SafeConnect(svMap.InputBegan, function(input)
                    if not input then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragSV = true
                    end
                end)
                SafeConnect(hueBar.InputBegan, function(input)
                    if not input then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragHue = true
                    end
                end)

                SafeConnect(UserInputService.InputChanged, function(input)
                    if not input then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement
                    and input.UserInputType ~= Enum.UserInputType.Touch then return end

                    if dragSV and svMap then
                        local absX = svMap.AbsolutePosition.X
                        local absY = svMap.AbsolutePosition.Y
                        local w    = svMap.AbsoluteSize.X
                        local h    = svMap.AbsoluteSize.Y
                        local relX = SafeClamp(SafeDivide(input.Position.X - absX, w, 0), 0, 1)
                        local relY = SafeClamp(SafeDivide(input.Position.Y - absY, h, 0), 0, 1)
                        saturation = relX
                        value = 1 - relY
                        pcall(function()
                            svCursor.Position = UDim2.new(saturation, 0, 1 - value, 0)
                        end)
                        UpdateColor()
                    elseif dragHue and hueBar then
                        local absY = hueBar.AbsolutePosition.Y
                        local h    = hueBar.AbsoluteSize.Y
                        local relY = SafeClamp(SafeDivide(input.Position.Y - absY, h, 0), 0, 1)
                        hue = relY
                        pcall(function() hueCursor.Position = UDim2.new(0.5, 0, hue, 0) end)
                        UpdateColor()
                    end
                end)
                SafeConnect(UserInputService.InputEnded, function(input)
                    if not input then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragSV, dragHue = false, false
                    end
                end)

                SafeConnect(colorButton.MouseButton1Click, function()
                    isOpen = not isOpen
                    if isOpen then
                        pcall(function() pickerFrame.Visible = true end)
                        Tween(pickerFrame, 0.2, { Size = UDim2.new(1, 0, 0, 110) })
                        colorFrame.Size = UDim2.new(1, 0, 0, 144)
                    else
                        Tween(pickerFrame, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
                        task.delay(0.2, function() pcall(function() pickerFrame.Visible = false end) end)
                        colorFrame.Size = UDim2.new(1, 0, 0, 30)
                    end
                end)

                if flag then Library.Flags[flag] = color end

                local obj = {}
                function obj:Set(newColor)
                    if typeof(newColor) ~= "Color3" then return end
                    hue, saturation, value = newColor:ToHSV()
                    pcall(function()
                        svCursor.Position = UDim2.new(saturation, 0, 1 - value, 0)
                        hueCursor.Position = UDim2.new(0.5, 0, hue, 0)
                    end)
                    UpdateColor()
                end
                function obj:Get() return color end
                return obj
            end

            return sectionObject
        end

        return tabObject
    end

    return windowObject
end

return Library
