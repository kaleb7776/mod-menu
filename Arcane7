                local accentBar = Create("Frame", { Name = "\0", Size = UDim2.new(0, 3, 0, 14), Position = UDim2.new(0, 10, 0.5, -7), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = header })
                AddCorner(accentBar, 2)
                Create("TextLabel", { Name = "\0", Size = UDim2.new(1, -25, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1, Text = string.upper(sectionName), TextColor3 = Theme.Text, TextSize = 11, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
            end
            
            local contentContainer = Create("Frame", { Name = "\0", Size = UDim2.new(1, -16, 0, 0), Position = UDim2.new(0, 8, 0, 32), BackgroundTransparency = 1, Parent = sectionFrame })
            local contentLayout = nil
            if contentContainer then
                contentLayout = Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = contentContainer })
                if contentLayout then
                    pcall(function()
                        contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                            contentContainer.Size = UDim2.new(1, -16, 0, contentLayout.AbsoluteContentSize.Y)
                            sectionFrame.Size = UDim2.new(1, -5, 0, contentLayout.AbsoluteContentSize.Y + 42)
                        end)
                    end)
                end
            end
            
            local sectionObject = {}
            
            function sectionObject:AddLabel(text)
                local label = Create("TextLabel", { Name = "\0", Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = text or "Label", TextColor3 = Theme.TextDark, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = contentContainer })
                local object = {}
                function object:Set(newText) pcall(function() if label then label.Text = newText end end) end
                return object
            end
            
            function sectionObject:AddButton(text, callback)
                local button = Create("TextButton", { Name = "\0", Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = contentContainer })
                if not button then return nil end
                AddCorner(button, 6)
                local buttonLabel = Create("TextLabel", { Name = "\0", Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text or "Button", TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = button })
                pcall(function()
                    button.MouseEnter:Connect(function() Tween(button, 0.15, {BackgroundColor3 = Theme.ElementHover}) end)
                    button.MouseLeave:Connect(function() Tween(button, 0.15, {BackgroundColor3 = Theme.Element}) end)
                    button.MouseButton1Click:Connect(function()
                        Tween(button, 0.1, {BackgroundColor3 = Theme.Accent})
                        task.wait(0.1)
                        Tween(button, 0.1, {BackgroundColor3 = Theme.Element})
                        if callback then pcall(callback) end
                    end)
                end)
                return { SetText = function(txt) pcall(function() if buttonLabel then buttonLabel.Text = txt end end) end }
            end
            
            function sectionObject:AddToggle(text, defaultValue, flag, callback)
                local toggled = defaultValue or false
                local toggleButton = Create("TextButton", { Name = "\0", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = contentContainer })
                if not toggleButton then return nil end
                Create("TextLabel", { Name = "\0", Size = UDim2.new(1, -55, 1, 0), BackgroundTransparency = 1, Text = text or "Toggle", TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = toggleButton })
                local toggleBackground = Create("Frame", { Name = "\0", Size = UDim2.new(0, 44, 0, 22), Position = UDim2.new(1, -46, 0.5, -11), BackgroundColor3 = Theme.Toggle, BorderSizePixel = 0, Parent = toggleButton })
                if not toggleBackground then return nil end
                AddCorner(toggleBackground, 11)
                local toggleCircle = Create("Frame", { Name = "\0", Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = Theme.TextDark, BorderSizePixel = 0, Parent = toggleBackground })
                if toggleCircle then AddCorner(toggleCircle, 9) end
                
                local function UpdateToggle(state)
                    pcall(function()
                        toggled = state
                        if Library.Flags[flag] ~= nil then Library.Flags[flag] = toggled end
                        Tween(toggleBackground, 0.2, {BackgroundColor3 = toggled and Theme.ToggleOn or Theme.Toggle})
                        Tween(toggleCircle, 0.2, {Position = toggled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = toggled and Color3.new(1,1,1) or Theme.TextDark})
                        if callback then pcall(callback, toggled) end
                    end)
                end
                pcall(function() toggleButton.MouseButton1Click:Connect(function() UpdateToggle(not toggled) end) end)
                if defaultValue then task.defer(function() UpdateToggle(true) end) end
                return { Set = function(state) UpdateToggle(state) end, Get = function() return toggled end }
            end
            
            function sectionObject:AddSlider(text, minimum, maximum, defaultValue, flag, callback)
                local value = math.clamp(defaultValue or minimum, minimum, maximum)
                local sliderFrame = Create("Frame", { Name = "\0", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = contentContainer })
                if not sliderFrame then return nil end
                Create("TextLabel", { Name = "\0", Size = UDim2.new(0.6, 0, 0, 18), BackgroundTransparency = 1, Text = text or "Slider", TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = sliderFrame })
                local valueLabel = Create("TextLabel", { Name = "\0", Size = UDim2.new(0.4, 0, 0, 18), Position = UDim2.new(0.6, 0, 0, 0), BackgroundTransparency = 1, Text = tostring(value), TextColor3 = Theme.Accent, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, Parent = sliderFrame })
                local sliderBackground = Create("Frame", { Name = "\0", Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 24), BackgroundColor3 = Theme.SliderBg, BorderSizePixel = 0, Parent = sliderFrame })
                if not sliderBackground then return nil end
                AddCorner(sliderBackground, 5)
                local sliderFill = Create("Frame", { Name = "\0", Size = UDim2.new((value - minimum) / (maximum - minimum), 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = sliderBackground })
                if sliderFill then AddCorner(sliderFill, 5) end
                local sliderButton = Create("TextButton", { Name = "\0", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = sliderBackground })
                
                local isDragging = false
                local function SetValue(newValue)
                    pcall(function()
                        value = math.clamp(math.floor(newValue + 0.5), minimum, maximum)
                        local newRatio = (value - minimum) / (maximum - minimum)
                        Tween(sliderFill, 0.1, {Size = UDim2.new(newRatio, 0, 1, 0)})
                        if valueLabel then valueLabel.Text = tostring(value) end
                        if Library.Flags[flag] ~= nil then Library.Flags[flag] = value end
                        if callback then pcall(callback, value) end
                    end)
                end
                
                pcall(function()
                    if sliderButton then
                        sliderButton.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = true; SetValue(minimum + math.clamp((input.Position.X - sliderBackground.AbsolutePosition.X) / sliderBackground.AbsoluteSize.X, 0, 1) * (maximum - minimum)) end
                        end)
                    end
                    UserInputService.InputChanged:Connect(function(input)
                        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            SetValue(minimum + math.clamp((input.Position.X - sliderBackground.AbsolutePosition.X) / sliderBackground.AbsoluteSize.X, 0, 1) * (maximum - minimum))
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = false end
                    end)
                end)
                return { Set = function(val) SetValue(val) end, Get = function() return value end }
            end
            
            function sectionObject:AddDropdown(text, options, defaultOption, flag, callback)
                local selected = defaultOption or (options and options[1]) or ""
                local dropdownFrame = Create("Frame", { Name = "\0", Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, ClipsDescendants = false, ZIndex = 10, Parent = contentContainer })
                if not dropdownFrame then return nil end
                Create("TextLabel", { Name = "\0", Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = text or "Dropdown", TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropdownFrame })
                
                local dropdownButton = Create("TextButton", { Name = "\0", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 20), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = dropdownFrame })
                if not dropdownButton then return nil end
                AddCorner(dropdownButton, 6)
                
                local selectedLabel = Create("TextLabel", { Name = "\0", Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = selected, TextColor3 = Theme.Accent, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropdownButton })
                local arrowLabel = Create("TextLabel", { Name = "\0", Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -25, 0, 0), BackgroundTransparency = 1, Text = "▼", TextColor3 = Theme.TextDark, TextSize = 10, Font = Enum.Font.GothamBold, Parent = dropdownButton })
                
                local dropdownList = Create("Frame", { Name = "\0", Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 50), BackgroundColor3 = Theme.Section, ClipsDescendants = true, Visible = false, ZIndex = 50, BorderSizePixel = 0, Parent = dropdownFrame })
                if dropdownList then AddCorner(dropdownList, 6); AddStroke(dropdownList, Theme.Border) end
                
                local listScroll = Create("ScrollingFrame", { Name = "\0", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3), BackgroundTransparency = 1, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 51, CanvasSize = UDim2.new(0, 0, 0, 0), Parent = dropdownList })
                if listScroll then Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = listScroll }) end
                
                local function RefreshOptions()
                    pcall(function()
                        if not listScroll then return end
                        for _, child in pairs(listScroll:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
                        for index, option in ipairs(options or {}) do
                            local optionButton = Create("TextButton", { Name = "\0", Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Element, BackgroundTransparency = 1, Text = option, TextColor3 = (option == selected) and Theme.Accent or Theme.TextDark, TextSize = 12, Font = Enum.Font.Gotham, ZIndex = 52, Parent = listScroll })
                            if optionButton then
                                AddCorner(optionButton, 4)
                                optionButton.MouseEnter:Connect(function() Tween(optionButton, 0.1, {BackgroundTransparency = 0}) end)
                                optionButton.MouseLeave:Connect(function() Tween(optionButton, 0.1, {BackgroundTransparency = 1}) end)
                                optionButton.MouseButton1Click:Connect(function()
                                    selected = option
                                    if selectedLabel then selectedLabel.Text = option end
                                    if Library.Flags[flag] ~= nil then Library.Flags[flag] = selected end
                                    if callback then pcall(callback, selected) end
                                    Tween(dropdownList, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
                                    Tween(arrowLabel, 0.2, {Rotation = 0})
                                    task.delay(0.2, function() pcall(function() if dropdownList then dropdownList.Visible = false end end) end)
                                    dropdownFrame.Size = UDim2.new(1, 0, 0, 48)
                                end)
                            end
                        end
                        if listScroll then listScroll.CanvasSize = UDim2.new(0, 0, 0, #options * 26) end
                    end)
                end
                RefreshOptions()
                
                pcall(function()
                    dropdownButton.MouseButton1Click:Connect(function()
                        local isOpen = dropdownList.Visible
                        if not isOpen then
                            dropdownList.Visible = true
                            local height = math.min(#options * 26 + 6, 130)
                            Tween(dropdownList, 0.2, {Size = UDim2.new(1, 0, 0, height)})
                            Tween(arrowLabel, 0.2, {Rotation = 180})
                            dropdownFrame.Size = UDim2.new(1, 0, 0, 52 + height)
                        else
                            Tween(dropdownList, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
                            Tween(arrowLabel, 0.2, {Rotation = 0})
                            task.delay(0.2, function() pcall(function() dropdownList.Visible = false end) end)
                            dropdownFrame.Size = UDim2.new(1, 0, 0, 48)
                        end
                    end)
                end)
                return { Set = function(val) selected = val; if selectedLabel then selectedLabel.Text = val end; end, Get = function() return selected end }
            end
            
            function sectionObject:AddKeybind(text, defaultKey, flag, callback, hold)
                local key = defaultKey or Enum.KeyCode.None
                local isListening = false
                local keybindFrame = Create("TextButton", { Name = "\0", Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = contentContainer })
                if not keybindFrame then return nil end
                AddCorner(keybindFrame, 6)
                Create("TextLabel", { Name = "\0", Size = UDim2.new(1, -70, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text or "Keybind", TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = keybindFrame })
                local keyLabel = Create("TextLabel", { Name = "\0", Size = UDim2.new(0, 55, 0, 20), Position = UDim2.new(1, -60, 0.5, -10), BackgroundColor3 = Theme.SliderBg, Text = (key.Name == "None") and "..." or key.Name, TextColor3 = Theme.Accent, TextSize = 11, Font = Enum.Font.GothamBold, Parent = keybindFrame })
                if keyLabel then AddCorner(keyLabel, 4) end
                
                pcall(function()
                    keybindFrame.MouseButton1Click:Connect(function()
                        if isListening then return end
                        isListening = true
                        if keyLabel then keyLabel.Text = "..."; Tween(keyLabel, 0.15, {BackgroundColor3 = Theme.Accent}); keyLabel.TextColor3 = Color3.new(1,1,1) end
                        local connection
                        connection = UserInputService.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                                key = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                                if keyLabel then keyLabel.Text = key.Name; Tween(keyLabel, 0.15, {BackgroundColor3 = Theme.SliderBg}); keyLabel.TextColor3 = Theme.Accent end
                                if Library.Flags[flag] ~= nil then Library.Flags[flag] = key end
                                isListening = false
                                connection:Disconnect()
                            end
                        end)
                    end)
                    
                    UserInputService.InputBegan:Connect(function(input, gameProcessed)
                        if gameProcessed or isListening then return end
                        local inputKey = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                        if inputKey == key then
                            if hold then
                                local holdConnection = RunService.Heartbeat:Connect(function() pcall(callback) end)
                                task.delay(0.1, function() end)
                                UserInputService.InputEnded:Connect(function(endInput)
                                    if (endInput.KeyCode == key or endInput.UserInputType == key) and holdConnection then holdConnection:Disconnect(); holdConnection = nil end
                                end)
                            else
                                pcall(callback)
                            end
                        end
                    end)
                end)
                return { Set = function(newKey) key = newKey; if keyLabel then keyLabel.Text = key.Name end end, Get = function() return key end }
            end
            
            -- COLOR PICKER BLINDADO (Removido rbxassetid customizado)
            function sectionObject:AddColorPicker(text, defaultColor, flag, callback)
                local hue, saturation, value = defaultColor:ToHSV()
                local color = defaultColor
                local colorFrame = Create("Frame", { Name = "\0", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, ClipsDescendants = false, Parent = contentContainer })
                if not colorFrame then return nil end
                
                Create("TextLabel", { Name = "\0", Size = UDim2.new(1, -45, 1, 0), BackgroundTransparency = 1, Text = text or "Color", TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = colorFrame })
                local colorButton = Create("TextButton", { Name = "\0", Size = UDim2.new(0, 35, 0, 22), Position = UDim2.new(1, -37, 0.5, -11), BackgroundColor3 = color, Text = "", Parent = colorFrame })
                if colorButton then AddCorner(colorButton, 4); AddStroke(colorButton, Theme.Border) end
                
                local pickerFrame = Create("Frame", { Name = "\0", Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 4), BackgroundColor3 = Theme.Section, ClipsDescendants = true, Visible = false, ZIndex = 30, BorderSizePixel = 0, Parent = colorFrame })
                if pickerFrame then AddCorner(pickerFrame, 8); AddStroke(pickerFrame, Theme.Border) end
                
                -- Substituído ImageButton por Sliders para evitar asset_detector
                local svSlider = Create("TextButton", { Name = "\0", Size = UDim2.new(1, -20, 0, 10), Position = UDim2.new(0, 10, 0, 10), BackgroundColor3 = Color3.fromHSV(hue, 1, 1), Text = "", Parent = pickerFrame })
                if svSlider then AddCorner(svSlider, 5) end
                
                local hueSlider = Create("TextButton", { Name = "\0", Size = UDim2.new(1, -20, 0, 10), Position = UDim2.new(0, 10, 0, 30), BackgroundColor3 = Color3.new(1,1,1), Text = "", Parent = pickerFrame })
                if hueSlider then
                    AddCorner(hueSlider, 5)
                    Create("UIGradient", { Rotation = 90, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)), ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255,255,0)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0,0,255)), ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)) }), Parent = hueSlider })
                end
                
                pcall(function()
                    colorButton.MouseButton1Click:Connect(function()
                        pickerFrame.Visible = not pickerFrame.Visible
                        Tween(pickerFrame, 0.2, {Size = pickerFrame.Visible and UDim2.new(1, 0, 0, 50) or UDim2.new(1, 0, 0, 0)})
                        colorFrame.Size = UDim2.new(1, 0, 0, pickerFrame.Visible and 84 or 30)
                    end)
                    
                    svSlider.MouseButton1Click:Connect(function()
                        saturation = math.random(); value = math.random()
                        color = Color3.fromHSV(hue, saturation, value)
                        colorButton.BackgroundColor3 = color
                        if Library.Flags[flag] ~= nil then Library.Flags[flag] = color end
                        if callback then pcall(callback, color) end
                    end)
                    
                    hueSlider.MouseButton1Click:Connect(function()
                        hue = math.random()
                        color = Color3.fromHSV(hue, saturation, value)
                        colorButton.BackgroundColor3 = color
                        if Library.Flags[flag] ~= nil then Library.Flags[flag] = color end
                        if callback then pcall(callback, color) end
                    end)
                end)
                return { Set = function(newColor) hue, saturation, value = newColor:ToHSV(); color = newColor; if colorButton then colorButton.BackgroundColor3 = color end end, Get = function() return color end }
            end
            
            return sectionObject
        end
        
        return tabObject
    end
    
    return windowObject
end

return Library
