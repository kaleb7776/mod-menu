        if closeButton then
            AddCorner(closeButton, 6)
            SafeConnect(closeButton.MouseButton1Click, function()
                Library:Confirm(
                    "Encerrar Interface",
                    "Tem certeza que deseja encerrar a interface?",
                    function(confirmed)
                        if not confirmed then
                            Library:Notify("Cancelado", "Operação cancelada.", 2, "Info")
