            function sectionObject:AddKeybind(text, defaultKey, flag, callback, hold)
                defaultKey = defaultKey or Enum.KeyCode.None
                callback = callback or function() end
                hold = hold == true
                local key = defaultKey
                local isListening, isHolding, holdConn = false, false, nil
                local kb = SafeNew("TextButton", {
                    Name = "Keybind", Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Element,
                    Text = "", AutoButtonColor = false, Parent = contentContainer,
                })
                if not kb then return nil end
                AddCorner(kb, 6); SetColor(kb, "BackgroundColor3", "Element")
                SafeNew("TextLabel", {
                    Name = "Label", Size = UDim2.new(1, -70, 1, 0), Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1, Text = tostring(text or "Keybind"), TextColor3 = Theme.Text,
                    TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = kb,
                })
                local kl = SafeNew("TextLabel", {
                    Name = "Key", Size = UDim2.new(0, 55, 0, 20), Position = UDim2.new(1, -60, 0.5, -10),
                    BackgroundColor3 = Theme.SliderBg,
                    Text = (tostring(key) == "Enum.KeyCode.None") and "..." or tostring(key):gsub("Enum.KeyCode.", ""),
                    TextColor3 = Theme.Accent, TextSize = 11, Font = Enum.Font.GothamBold, Parent = kb,
                })
                AddCorner(kl, 4); SetColor(kl, "BackgroundColor3", "SliderBg")
                SafeConnect(kb.MouseButton1Click, function()
                    if isListening then return end
                    isListening = true
                    pcall(function()
                        kl.Text = "..."
                        Tween(kl, 0.15, { BackgroundColor3 = Theme.Accent })
                        kl.TextColor3 = Color3.new(1,1,1)
                    end)
                    local conn
                    conn = SafeConnect(UserInputService.InputBegan, function(input)
                        if not input then return end
                        local isKb = input.UserInputType == Enum.UserInputType.Keyboard
                        local isMb = input.UserInputType == Enum.UserInputType.MouseButton1
                            or input.UserInputType == Enum.UserInputType.MouseButton2
                            or input.UserInputType == Enum.UserInputType.MouseButton3
                        if isKb or isMb then
                            key = isKb and input.KeyCode or input.UserInputType
                            pcall(function()
                                kl.Text = tostring(key):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
                                Tween(kl, 0.15, { BackgroundColor3 = Theme.SliderBg })
                                kl.TextColor3 = Theme.Accent
                            end)
                            if flag then Library.Flags[flag] = key end
                            isListening = false
                            if conn then pcall(function() conn:Disconnect() end) end
                        end
                    end)
                end)
                SafeConnect(kb.MouseEnter, function() Tween(kb, 0.15, { BackgroundColor3 = Theme.ElementHover }) end)
                SafeConnect(kb.MouseLeave, function() Tween(kb, 0.15, { BackgroundColor3 = Theme.Element }) end)
                SafeConnect(UserInputService.InputBegan, function(input, gp)
                    if gp or isListening or not input then return end
                    local inKey = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                    if inKey == key then
                        if hold then
                            isHolding = true
                            if holdConn then pcall(function() holdConn:Disconnect() end) end
                            holdConn = SafeConnect(RunService.Heartbeat, function()
                                if isHolding then SafeCall(callback) end
                            end)
                        else SafeCall(callback) end
                    end
                end)
                SafeConnect(UserInputService.InputEnded, function(input, gp)
                    if gp or not input then return end
                    local inKey = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                    if inKey == key and hold then
                        isHolding = false
                        if holdConn then pcall(function() holdConn:Disconnect() end); holdConn = nil end
                    end
                end)
                if flag then Library.Flags[flag] = key end
                local o = {}
                function o:Set(k)
                    key = k
                    pcall(function()
                        kl.Text = (tostring(key) == "Enum.KeyCode.None") and "..." or tostring(key):gsub("Enum.KeyCode.", "")
                    end)
                    if flag then Library.Flags[flag] = key end
                end
                function o:Get() return key end
                RegisterControl(flag, function(v)
                    key = v
                    pcall(function()
                        kl.Text = (tostring(key) == "Enum.KeyCode.None") and "..." or tostring(key):gsub("Enum.KeyCode.", "")
                    end)
                end)
                return o
            end

