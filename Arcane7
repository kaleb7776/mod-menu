function Library:CreateWindow(configuration, toggleKey)
    if type(configuration) == "string" then
        configuration = { Title = configuration, ToggleKey = toggleKey }
    end
    configuration = configuration or {}

    local windowTitle      = tostring(configuration.Title or "SKECH[beta]")
    local windowKeybind    = configuration.ToggleKey or Enum.KeyCode.RightControl
    local windowIcon       = tostring(configuration.Icon or "")
    local windowFolder     = tostring(configuration.Folder or "RavionUI")
    local windowSize       = configuration.Size or UDim2.new(0, 600, 0, 400)
    local windowMinSize    = configuration.MinSize or Vector2.new(400, 300)
    local windowMaxSize    = configuration.MaxSize or Vector2.new(1000, 800)
    local hideFooter       = configuration.HideFooter ~= false
    local effectiveFooterHeight = hideFooter and 0 or (tonumber(configuration.FooterHeight) or 50)

    Library.Keybind = windowKeybind

    -- limpeza
    SafeCall(function()
        local oldGui = LocalPlayer.PlayerGui:FindFirstChild(windowFolder)
        if oldGui then oldGui:Destroy() end
    end)
    SafeCall(function()
        local oldCoreGui = CoreGui:FindFirstChild(windowFolder)
        if oldCoreGui then oldCoreGui:Destroy() end
    end)

    local screenGui = SafeNew("ScreenGui", {
        Name = windowFolder,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        ResetOnSpawn = false,
    })
    if not screenGui then
        warn("[Ravion] Falha ao criar ScreenGui")
        return nil
    end
    local ok = pcall(function() screenGui.Parent = CoreGui end)
    if not ok then
        pcall(function() screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
    end

    Library._ScreenGui = screenGui
    Library._NotificationGui = NotificationGui
    CloneRef:Keep("ScreenGui", screenGui)

    -- Botão flutuante mobile
    local mobileButton = SafeNew("TextButton", {
        Name = "MobileButton",
        Size = UDim2.new(0, 50, 0, 50),
        Position = UDim2.new(0, 20, 0.5, -25),
        BackgroundColor3 = Theme.Section,
        Text = "", AutoButtonColor = false,
        Visible = false, ZIndex = 100, Parent = screenGui,
    })
    if mobileButton then
        AddCorner(mobileButton, 25)
        AddStroke(mobileButton, Theme.Accent, 2)
        MakeDraggable(mobileButton, mobileButton)

        if windowIcon ~= "" then
            SafeNew("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = windowIcon, TextColor3 = Theme.Text,
                TextSize = 28, Font = Enum.Font.SourceSansBold,
                TextScaled = true, Parent = mobileButton,
            })
        else
            SafeNew("ImageLabel", {
                Size = UDim2.new(1, -8, 1, -8),
                Position = UDim2.new(0, 4, 0, 4),
                BackgroundTransparency = 1,
                Image = "https://i.postimg.cc/WbFVrmNQ/logo1-removebg-preview-(1).png",
                ScaleType = Enum.ScaleType.Fit, Parent = mobileButton,
            })
        end
    end
    Library._MobileButton = mobileButton
    CloneRef:Keep("MobileButton", mobileButton)

    -- Tamanho
    local useScale = true
    local scaleX  = windowSize.X.Scale
    local scaleY  = windowSize.Y.Scale
    local offsetX = windowSize.X.Offset
    local offsetY = windowSize.Y.Offset
    if scaleX == 0 and scaleY == 0 and (offsetX > 0 or offsetY > 0) then
        useScale = false
    end

    local mainSize
    if useScale then
        if scaleX <= 0 then scaleX = 0.7 end
        if scaleY <= 0 then scaleY = 0.7 end
        mainSize = UDim2.new(scaleX, 0, scaleY, 0)
    else
        local w = SafeClamp(offsetX, windowMinSize.X, windowMaxSize.X)
        local h = SafeClamp(offsetY, windowMinSize.Y, windowMaxSize.Y)
        mainSize = UDim2.new(0, w, 0, h)
    end

    local mainFrame = SafeNew("Frame", {
        Name = "Main",
        Size = mainSize,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0, Parent = screenGui,
    })
    if not mainFrame then
        warn("[Ravion] Falha ao criar frame principal")
        return nil
    end
    AddCorner(mainFrame, 10)
    AddStroke(mainFrame, Theme.Border)
    Library._MainFrame = mainFrame
    CloneRef:Keep("MainFrame", mainFrame)

