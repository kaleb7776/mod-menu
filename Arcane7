-- pcall genérico com log opcional
local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return nil end
    local ok, res = pcall(fn, ...)
    if not ok then
        warn("[Ravion][SafeCall] " .. tostring(res))
        return nil
    end
    return res
end

-- Divisão segura: evita /0, NaN, inf
local function SafeDivide(a, b, default)
    default = default or 0
    if type(a) ~= "number" or type(b) ~= "number" then return default end
    if a ~= a or b ~= b then return default end          -- NaN
    if b == 0 then return default end
    local r = a / b
    if r ~= r or r == math.huge or r == -math.huge then return default end
    return r
end

-- Clamp seguro (evita NaN travando)
local function SafeClamp(v, min, max)
    if type(v) ~= "number" or v ~= v then return min or 0 end
    if v < (min or -math.huge) then return min or 0 end
    if v > (max or math.huge) then return max or 0 end
    return v
end

-- Conexão segura para qualquer Signal do Roblox
local function SafeConnect(signal, callback)
    if not signal then return nil end
    local ok, conn = pcall(function()
        return signal:Connect(function(...)
            local success, err = pcall(callback, ...)
            if not success then
                warn("[Ravion][SafeConnect] callback error: " .. tostring(err))
            end
        end)
    end)
    if ok then return conn end
    return nil
end

-- ================================================================
-- CLONE REF (cache de referências + template cloning)
-- Evita GC, reutiliza propriedades e acelera criação
-- ================================================================
local CloneRef = {
    _refs = setmetatable({}, { __mode = "v" }),  -- weak refs
    _templates = {},
}

function CloneRef:Keep(name, instance)
    if not instance then return end
    self._refs[name] = instance
end

function CloneRef:Get(name)
    return self._refs[name]
end

function CloneRef:Template(name, class, props)
    local existing = self._templates[name]
    if existing and existing.ClassName == class then return existing end
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then return nil end
    if props then
        for k, v in pairs(props) do
            pcall(function() inst[k] = v end)
        end
    end
    self._templates[name] = inst
    return inst
end

-- ================================================================
-- INSTANCE.NEW ROBUSTO (substitui todas as chamadas diretas)
-- ================================================================
local function SafeNew(class, props)
    if type(class) ~= "string" then
        warn("[Ravion][SafeNew] class inválida: " .. tostring(class))
        return nil
    end
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then
        warn("[Ravion][SafeNew] falha ao criar " .. class .. ": " .. tostring(inst))
        return nil
    end
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then
                pcall(function() inst[k] = v end)
            end
        end
        if props.Parent then
            pcall(function() inst.Parent = props.Parent end)
        end
    end
    return inst
end

-- Wrapper legado (compatibilidade com o resto do código)
local function Create(class, props)
    return SafeNew(class, props)
end

