function Library:Notify(title, text, duration, ntype)
    if not NotificationHolder then return end
    duration = tonumber(duration) or 3
    if duration ~= duration or duration <= 0 then duration = 3 end
    ntype = ntype or "Info"
    local sid = NotificationSounds[ntype]
    if sid then
        SafeCall(function()
            local s = SafeNew("Sound", { SoundId = sid, Volume = 0.5, Parent = NotificationGui or CoreGui })
            if s then
                pcall(function() s:Play() end)
                task.delay(math.max(1, tonumber(s.TimeLength) or 2), function() pcall(function() s:Destroy() end) end)
            end
        end)
    end
    local colors = { Info = Theme.Accent, Success = Theme.Success, Warning = Theme.Warning, Error = Theme.Error }
    local n = SafeNew("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = Theme.Section, Parent = NotificationHolder })
    if not n then return end
    AddCorner(n, 8); AddStroke(n, Theme.Border)
    local ab = SafeNew("Frame", {
        Size = UDim2.new(0, 4, 1, -10), Position = UDim2.new(0, 5, 0, 5),
        BackgroundColor3 = colors[ntype] or Theme.Accent, BorderSizePixel = 0, Parent = n,
    })
    AddCorner(ab, 2)
    SafeNew("TextLabel", {
        Size = UDim2.new(1, -50, 0, 22), Position = UDim2.new(0, 18, 0, 8),
        BackgroundTransparency = 1, Text = tostring(title or "Notificação"),
        TextColor3 = Theme.Text, TextSize = 14, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = n,
    })
    SafeNew("TextLabel", {
        Size = UDim2.new(1, -25, 0, 32), Position = UDim2.new(0, 18, 0, 30),
        BackgroundTransparency = 1, Text = tostring(text or ""),
        TextColor3 = Theme.TextDark, TextSize = 12, Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, Parent = n,
    })
    local p = SafeNew("Frame", {
        Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = colors[ntype] or Theme.Accent, BorderSizePixel = 0, Parent = n,
    })
    n.Position = UDim2.new(1, 20, 0, 0)
    Tween(n, 0.3, { Position = UDim2.new(0, 0, 0, 0) })
    if p then Tween(p, duration, { Size = UDim2.new(0, 0, 0, 3) }) end
    task.delay(duration, function()
        SafeCall(function()
            if n and n.Parent then
                Tween(n, 0.3, { Position = UDim2.new(1, 20, 0, 0) })
                task.wait(0.35)
                pcall(function() n:Destroy() end)
            end
        end)
    end)
end

