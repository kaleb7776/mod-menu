local function SetupNotifications()
    NotificationGui = SafeNew("ScreenGui", {
        Name = "RavionNotifications",
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        ResetOnSpawn = false,
    })
    if not NotificationGui then return end

    local ok = pcall(function() NotificationGui.Parent = CoreGui end)
