function Library:GetIcon(name, pack)
    if not NebulaIcons then SafeCall(LoadNebulaIcons) end
    if NebulaIcons then
        local ok, res = pcall(function() return NebulaIcons:GetIcon(name, pack) end)
        if ok then return res end
