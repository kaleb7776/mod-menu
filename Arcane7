                })
                AddCorner(svCursor, 4); AddStroke(svCursor, Color3.new(0,0,0), 1)
                local hueBar = SafeNew("ImageButton", {
                    Name = "HueBar", Size = UDim2.new(0, 18, 0, 90), Position = UDim2.new(0, 140, 0, 10),
                    BackgroundColor3 = Color3.new(1,1,1), AutoButtonColor = false, ZIndex = 31, Parent = pf,
                })
                AddCorner(hueBar, 4)
                SafeNew("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
                        ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255,255,0)),
                        ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0,255,0)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
                        ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0,0,255)),
                        ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255,0,255)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
                    }), Parent = hueBar,
                })
                local hueCursor = SafeNew("Frame", {
                    Name = "Cursor", Size = UDim2.new(1, 4, 0, 4), AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0.5, 0, hue, 0), BackgroundColor3 = Color3.new(1,1,1),
                    ZIndex = 32, BorderSizePixel = 0, Parent = hueBar,
                })
                AddCorner(hueCursor, 2); AddStroke(hueCursor, Color3.new(0,0,0), 1)
                local function UpdateColor()
                    color = Color3.fromHSV(SafeClamp(hue,0,1), SafeClamp(saturation,0,1), SafeClamp(value,0,1))
                    pcall(function() cb.BackgroundColor3 = color end)
                    pcall(function() svMap.BackgroundColor3 = Color3.fromHSV(SafeClamp(hue,0,1), 1, 1) end)
                    if flag then Library.Flags[flag] = color end
                    SafeCall(callback, color)
                end
                local dragSV, dragHue = false, false
                SafeConnect(svMap.InputBegan, function(input)
                    if input and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then dragSV = true end
                end)
                SafeConnect(hueBar.InputBegan, function(input)
                    if input and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then dragHue = true end
                end)
                SafeConnect(UserInputService.InputChanged, function(input)
                    if not input then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement
                    and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    if dragSV and svMap then
                        local relX = SafeClamp(SafeDivide(input.Position.X - svMap.AbsolutePosition.X, svMap.AbsoluteSize.X, 0), 0, 1)
                        local relY = SafeClamp(SafeDivide(input.Position.Y - svMap.AbsolutePosition.Y, svMap.AbsoluteSize.Y, 0), 0, 1)
                        saturation, value = relX, 1 - relY
                        pcall(function() svCursor.Position = UDim2.new(saturation, 0, 1 - value, 0) end)
                        UpdateColor()
                    elseif dragHue and hueBar then
                        local relY = SafeClamp(SafeDivide(input.Position.Y - hueBar.AbsolutePosition.Y, hueBar.AbsoluteSize.Y, 0), 0, 1)
                        hue = relY
                        pcall(function() hueCursor.Position = UDim2.new(0.5, 0, hue, 0) end)
                        UpdateColor()
                    end
                end)
                SafeConnect(UserInputService.InputEnded, function(input)
                    if input and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then dragSV, dragHue = false, false end
                end)
                SafeConnect(cb.MouseButton1Click, function()
                    isOpen = not isOpen
                    if isOpen then
                        pcall(function() pf.Visible = true end)
                        Tween(pf, 0.2, { Size = UDim2.new(1, 0, 0, 110) })
                        cf.Size = UDim2.new(1, 0, 0, 144)
                    else
                        Tween(pf, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
                        task.delay(0.2, function() pcall(function() pf.Visible = false end) end)
                        cf.Size = UDim2.new(1, 0, 0, 30)
                    end
                end)
                if flag then Library.Flags[flag] = color end
                local o = {}
                function o:Set(newColor)
                    if typeof(newColor) ~= "Color3" then return end
                    hue, saturation, value = newColor:ToHSV()
                    pcall(function()
                        svCursor.Position = UDim2.new(saturation, 0, 1 - value, 0)
                        hueCursor.Position = UDim2.new(0.5, 0, hue, 0)
                    end)
                    UpdateColor()
                end
                function o:Get() return color end
                RegisterControl(flag, function(v)
                    if typeof(v) == "Color3" then
                        hue, saturation, value = v:ToHSV()
                        pcall(function()
                            svCursor.Position = UDim2.new(saturation, 0, 1 - value, 0)
                            hueCursor.Position = UDim2.new(0.5, 0, hue, 0)
                        end)
                        UpdateColor()
                    end
                end)
                return o
            end

            return sectionObject
        end

        return tabObject
    end

    -- ============================================================
    -- Salva window pra CreateConfigTab usar
    -- ============================================================
    Library._LastWindow = windowObject

    -- ============================================================
    -- [NOVO] AUTO-CRIA ABA CONFIG (sem precisar chamar)
    -- ============================================================
    if autoConfigTab and not Library._ConfigTabCreated then
        task.defer(function()
            task.wait(0.1)
            if Library.CreateConfigTab then
                pcall(function()
                    Library:CreateConfigTab(windowObject)
                end)
            end
        end)
    end

    return windowObject
end

-- ================================================================
-- ABA CONFIG (FORA de CreateWindow — sempre definida)
-- ================================================================
function Library:CreateConfigTab(window)
    -- Guard anti-duplicação
    if Library._ConfigTabCreated then
        warn("[Ravion] Aba Config já existe, ignorando.")
        return Library._ConfigTab
    end

    window = window or Library._LastWindow
    if not window then
        warn("[Ravion] CreateConfigTab: nenhuma window. Chame Library:CreateWindow() antes.")
        return nil
    end
    if type(window.AddTab) ~= "function" then
        warn("[Ravion] CreateConfigTab: window inválida.")
        return nil
    end

    local cfgTab = window:AddTab("⚙️ Config", "⚙️")
    if not cfgTab then
        warn("[Ravion] CreateConfigTab: AddTab retornou nil.")
        return nil
    end

    Library._ConfigTab = cfgTab
    Library._ConfigTabCreated = true

    -- Move a aba Config pro FINAL do sidebar
    pcall(function()
        local screenGui = Library._ScreenGui
        if not screenGui then return end
        local main = screenGui:FindFirstChild("Main")
        if not main then return end
        local sidebar = main:FindFirstChild("Sidebar")
        if not sidebar then return end
        local tabHolder = sidebar:FindFirstChild("TabHolder")
        if not tabHolder then return end

        local cfgBtn = tabHolder:FindFirstChild("⚙️ Config")
        if not cfgBtn then return end

        local lastOrder = 0
        for _, child in ipairs(tabHolder:GetChildren()) do
            if child:IsA("TextButton") and child ~= cfgBtn then
                if child.LayoutOrder > lastOrder then lastOrder = child.LayoutOrder end
            end
        end
        cfgBtn.LayoutOrder = lastOrder + 1
    end)

    -- ════════════════════════════════════════════════════════════
    -- APARÊNCIA
    -- ════════════════════════════════════════════════════════════
    local appS = cfgTab:AddSection("🎨 Aparência")
    if appS then
        pcall(function()
            appS:AddDropdown("Tema", Themes._Order,
                Library.Flags["Config_Theme"] or "SKECH", "Config_Theme",
                function(name)
                    Library:ApplyTheme(name)
                    Library:Notify("🎨 Tema", "Aplicado: " .. tostring(name), 2, "Success")
                end)

            appS:AddSlider("Transparência", 0, 80, 0, "Config_Transparency", function(v)
                if Library._MainFrame then
                    Library._MainFrame.BackgroundTransparency = SafeDivide(v, 100, 0)
                end
            end)

            appS:AddToggle("Animações Suaves", true, "Config_Animations", function(state)
                _G.RavionTweenSpeed = state and 0.2 or 0
            end)
        end)
    end

    -- ════════════════════════════════════════════════════════════
    -- COMPORTAMENTO
    -- ════════════════════════════════════════════════════════════
    local behS = cfgTab:AddSection("🎮 Comportamento")
    if behS then
        pcall(function()
            behS:AddKeybind("Tecla de Abrir/Fechar", Library.Keybind, "Config_ToggleKey",
                function(k) Library.Keybind = k end)

            behS:AddToggle("Auto-Salvar ao Fechar", true, "Config_AutoSave",
                function(s) Library.AutoSave = s end)

            behS:AddToggle("Começar Minimizado", false, "Config_StartMin", function(state)
                Library.StartMinimized = state
                if state and Library._MainFrame then
                    Library._MainFrame.Visible = false
                    Library.Open = false
                end
            end)
        end)
    end

    -- ════════════════════════════════════════════════════════════
    -- CONFIGS SALVOS
    -- ════════════════════════════════════════════════════════════
    local savS = cfgTab:AddSection("💾 Configs Salvos")
    local currentName = "default"
    local cfgList = nil

    if savS then
        pcall(function()
            savS:AddTextbox("Nome do Config", "Config_Name", function(txt)
                if txt and txt ~= "" then
                    currentName = tostring(txt):gsub("[^%w_%-]", "_")
                end
            end)

            cfgList = savS:AddDropdown("Configs Encontrados",
                Library:ListConfigs(), Library:GetAutoLoad() or "default",
                "Config_List", function(n) currentName = n end)

            savS:AddButton("🔄 Atualizar Lista", function()
                if cfgList then cfgList:Refresh(Library:ListConfigs()) end
                Library:Notify("Lista", #Library:ListConfigs() .. " config(s).", 2, "Info")
            end)

            savS:AddButton("💾 Salvar Config", function()
                Library:SaveConfig(currentName)
                Library.Flags["Config_LastUsed"] = currentName
                if cfgList then cfgList:Refresh(Library:ListConfigs()) end
            end)

            savS:AddButton("📂 Carregar Config", function()
                Library:LoadConfig(currentName)
            end)

            savS:AddButton("🗑️ Deletar Config", function()
                Library:Confirm("Deletar", "Remover '" .. currentName .. "'?", function(ok2)
                    if ok2 then
                        Library:DeleteConfig(currentName)
                        if cfgList then cfgList:Refresh(Library:ListConfigs()) end
                    end
                end)
            end)
        end)
    end

    -- ════════════════════════════════════════════════════════════
    -- AUTOLOAD
    -- ════════════════════════════════════════════════════════════
    local autoS = cfgTab:AddSection("⚡ AutoLoad")
    if autoS then
        pcall(function()
            autoS:AddButton("Marcar como AutoLoad", function() Library:SetAutoLoad(currentName) end)
            autoS:AddButton("❌ Remover AutoLoad", function() Library:ClearAutoLoad() end)
        end)
    end

    -- ════════════════════════════════════════════════════════════
    -- COMPARTILHAR
    -- ════════════════════════════════════════════════════════════
    local shS = cfgTab:AddSection("📤 Compartilhar")
    if shS then
        pcall(function()
            shS:AddButton("📋 Copiar Config", function()
                local str = Library:ExportConfigString()
                if not str then Library:Notify("Erro", "Falha ao exportar.", 2, "Error"); return end
                if setclipboard then
                    pcall(setclipboard, str)
                    Library:Notify("📋 Copiado", "Config copiada!", 3, "Success")
                else
                    Library:Notify("Aviso", "setclipboard indisponível.", 3, "Warning")
                end
            end)
            shS:AddTextbox("Colar config aqui...", "Config_Import", function(str)
                if str and str ~= "" then
                    if Library:ImportConfigString(str) and cfgList then
                        cfgList:Refresh(Library:ListConfigs())
                    end
                end
            end)
        end)
    end

    -- ════════════════════════════════════════════════════════════
    -- ZONA DE PERIGO
    -- ════════════════════════════════════════════════════════════
    local dgS = cfgTab:AddSection("⚠️ Zona de Perigo")
    if dgS then
        pcall(function()
            dgS:AddButton("🔥 Resetar Todas as Flags", function()
                Library:Confirm("Resetar", "Apagar TODAS as flags?", function(ok2)
                    if ok2 then
                        Library.Flags = {}
                        Library:Notify("Resetado", "Tudo apagado.", 3, "Warning")
                    end
                end)
            end)
            dgS:AddButton("❌ Desinstalar Interface", function()
                Library:Confirm("Desinstalar", "Isso remove a UI inteira.\n\nContinuar?", function(ok2)
                    if ok2 then
                        pcall(function()
                            if Library._ScreenGui then Library._ScreenGui:Destroy() end
                            if Library._NotificationGui then Library._NotificationGui:Destroy() end
                        end)
                        Library.Flags = {}
                        Library._ScreenGui = nil
                        Library._MainFrame = nil
                        Library._MobileButton = nil
                        Library._Footer = nil
                        Library._NotificationGui = nil
                        Library._LastWindow = nil
                        Library._ConfigTab = nil
                        Library._ConfigTabCreated = false
                        _G.RavionUILoaded = nil
                        warn("[Ravion] Interface desinstalada.")
                    end
                end)
            end)
        end)
    end

    -- ════════════════════════════════════════════════════════════
    -- AUTO-LOAD ao iniciar
    -- ════════════════════════════════════════════════════════════
    task.defer(function()
        task.wait(0.5)
        local last = Library:GetAutoLoad()
        if last and last ~= "" then
            Library:Notify("⚡ AutoLoad", "Carregando '" .. last .. "'...", 2, "Info")
            Library:LoadConfig(last)
        else
            local t = Library.Flags["Config_Theme"]
            if t and Themes[t] then Library:ApplyTheme(t) end
        end
        if Library.Flags["Config_StartMin"] and Library._MainFrame then
            Library._MainFrame.Visible = false
            Library.Open = false
        end
    end)

    print("[Ravion] Aba Config criada automaticamente.")
    return cfgTab
end

-- ================================================================
-- REGISTRA NO _G COM FINGERPRINT
-- ================================================================
_G.RavionUILoaded = {
    Version = "1.5.0",
    Library = Library,
}

return Library
