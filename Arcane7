function Library:SaveConfig(name)
    if not HAS_FILE then Library:Notify("Erro", "Executor sem arquivos.", 3, "Error"); return false end
    EnsureFolder()
    name = tostring(name or "default"):gsub("[^%w_%-]", "_")
    if name == "" then name = "default" end
    local data = {
        __meta = { saved = os.time(), place = game.PlaceId, player = LocalPlayer and LocalPlayer.Name or "?" },
        flags = {}, window = {},
    }
    for flag, value in pairs(Library.Flags) do
        local s = Serialize(value)
        if s ~= nil then data.flags[flag] = s end
    end
    if Library._MainFrame then
        data.window.position = Serialize(Library._MainFrame.Position)
        data.window.size = Serialize(Library._MainFrame.Size)
    end
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then Library:Notify("Erro", "Falha ao serializar.", 3, "Error"); return false end
    local ok2 = pcall(writefile, CONFIG_FOLDER .. "/" .. name .. ".json", enc)
    if ok2 then Library:Notify("💾 Salvo", "'" .. name .. "' salvo!", 2, "Success"); return true end
    Library:Notify("Erro", "Falha ao gravar.", 3, "Error")
    return false
end

function Library:LoadConfig(name)
    if not HAS_FILE then return false end
    name = tostring(name or "default"):gsub("[^%w_%-]", "_")
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    local ok, content = pcall(readfile, path)
    if not ok or not content then Library:Notify("Erro", "'" .. name .. "' não encontrado.", 3, "Error"); return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or type(data) ~= "table" then Library:Notify("Erro", "Config corrompido.", 3, "Error"); return false end
    if type(data.flags) == "table" then
        for flag, value in pairs(data.flags) do
            local dec = Deserialize(value)
            if flag == "Config_Theme" and type(dec) == "string" then
                Library:ApplyTheme(dec)
            else
                local setter = ControlRegistry[flag]
                if setter then pcall(setter, dec) else Library.Flags[flag] = dec end
            end
        end
    end
    if type(data.window) == "table" and Library._MainFrame then
        if data.window.position then pcall(function() Library._MainFrame.Position = Deserialize(data.window.position) end) end
        if data.window.size then pcall(function() Library._MainFrame.Size = Deserialize(data.window.size) end) end
    end
    Library:Notify("📂 Carregado", "'" .. name .. "' aplicado!", 2, "Success")
    return true
end

function Library:ListConfigs()
    if not HAS_FILE then return {} end
    EnsureFolder()
    local ok, files = pcall(listfiles, CONFIG_FOLDER)
    if not ok or type(files) ~= "table" then return {} end
    local out = {}
    for _, f in ipairs(files) do
        local name = string.match(f, "([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    table.sort(out)
    return out
end

function Library:DeleteConfig(name)
    if not HAS_FILE or not delfile then return false end
    name = tostring(name or ""):gsub("[^%w_%-]", "_")
    local ok = pcall(delfile, CONFIG_FOLDER .. "/" .. name .. ".json")
    if ok then Library:Notify("🗑️ Deletado", "'" .. name .. "' removido.", 2, "Success") end
    return ok
end

function Library:ExportConfigString()
    local data = { flags = {}, window = {} }
    for flag, value in pairs(Library.Flags) do
        local s = Serialize(value)
        if s ~= nil then data.flags[flag] = s end
    end
    if Library._MainFrame then
        data.window.position = Serialize(Library._MainFrame.Position)
        data.window.size = Serialize(Library._MainFrame.Size)
    end
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    return ok and enc or nil
end

function Library:ImportConfigString(str)
    if type(str) ~= "string" or str == "" then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
    if not ok or type(data) ~= "table" then return false end
    if type(data.flags) == "table" then
        for flag, value in pairs(data.flags) do
            local dec = Deserialize(value)
            if flag == "Config_Theme" and type(dec) == "string" then
                Library:ApplyTheme(dec)
            else
                local setter = ControlRegistry[flag]
                if setter then pcall(setter, dec) else Library.Flags[flag] = dec end
            end
        end
    end
    if type(data.window) == "table" and Library._MainFrame then
        if data.window.position then pcall(function() Library._MainFrame.Position = Deserialize(data.window.position) end) end
        if data.window.size then pcall(function() Library._MainFrame.Size = Deserialize(data.window.size) end) end
    end
    Library:Notify("📥 Importado", "Config aplicada!", 2, "Success")
    return true
end

function Library:SetAutoLoad(name)
    if not HAS_FILE then return false end
    EnsureFolder()
    local ok = pcall(writefile, CONFIG_FOLDER .. "/_autoload.txt", tostring(name))
    if ok then Library:Notify("⚡ AutoLoad", "'" .. name .. "' ativado.", 2, "Info") end
    return ok
end

function Library:GetAutoLoad()
    if not HAS_FILE then return nil end
    local ok, name = pcall(readfile, CONFIG_FOLDER .. "/_autoload.txt")
    if ok and name and name ~= "" then return (name:gsub("%s", "")) end
    return nil
end

function Library:ClearAutoLoad()
    if not HAS_FILE then return false end
    local ok = pcall(writefile, CONFIG_FOLDER .. "/_autoload.txt", "")
    if ok then Library:Notify("AutoLoad", "Removido.", 2, "Info") end
    return ok
end

function Library:ApplyTheme(name)
    local t = Themes[name]
    if not t then return false end
    for k, v in pairs(t) do Theme[k] = v end
    for _, e in ipairs(ColorRegistry) do
        pcall(function()
            if e.inst and e.inst.Parent ~= nil then e.inst[e.prop] = Theme[e.key] end
        end)
    end
    for _, fn in ipairs(ThemeRefreshers) do pcall(fn) end
    Library.Flags["Config_Theme"] = name
    return true
end

