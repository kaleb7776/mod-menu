-- PROTEÇÕES GLOBAIS
-- ================================================================
local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return nil end
    local ok, res = pcall(fn, ...)
    if not ok then warn("[Ravion][SafeCall] " .. tostring(res)); return nil end
    return res
end

local function SafeDivide(a, b, default)
    default = default or 0
    if type(a) ~= "number" or type(b) ~= "number" then return default end
    if a ~= a or b ~= b then return default end
    if b == 0 then return default end
    local r = a / b
    if r ~= r or r == math.huge or r == -math.huge then return default end
    return r
end

local function SafeClamp(v, min, max)
    if type(v) ~= "number" or v ~= v then return min or 0 end
    if v < (min or -math.huge) then return min or 0 end
    if v > (max or math.huge) then return max or 0 end
    return v
end

local function SafeConnect(signal, callback)
    if not signal then return nil end
    local ok, conn = pcall(function()
        return signal:Connect(function(...)
            local s, e = pcall(callback, ...)
            if not s then warn("[Ravion][SafeConnect] " .. tostring(e)) end
        end)
    end)
    if ok then return conn end
    return nil
end

local CloneRef = { _refs = setmetatable({}, { __mode = "v" }), _templates = {} }
function CloneRef:Keep(name, inst) if inst then self._refs[name] = inst end end
function CloneRef:Get(name) return self._refs[name] end
function CloneRef:Template(name, class, props)
    local ex = self._templates[name]
    if ex and ex.ClassName == class then return ex end
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then return nil end
    if props then for k, v in pairs(props) do pcall(function() inst[k] = v end) end end
    self._templates[name] = inst
    return inst
end

local function SafeNew(class, props)
    if type(class) ~= "string" then return nil end
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then return nil end
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then pcall(function() inst[k] = v end) end
        end
        if props.Parent then pcall(function() inst.Parent = props.Parent end) end
    end
    return inst
end
local Create = SafeNew

local function Tween(object, time, properties)
    if not object or type(properties) ~= "table" then return nil end
    time = tonumber(time) or 0.15
    if time ~= time or time < 0 then time = 0.15 end
    local ok, tween = pcall(function()
        return TweenService:Create(object,
            TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
    end)
    if ok and tween then pcall(function() tween:Play() end); return tween end
    return nil
end

local function AddCorner(parent, radius)
    if not parent then return nil end
    return SafeNew("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = parent })
end

local function AddStroke(parent, color, thickness)
    if not parent then return nil end
    return SafeNew("UIStroke", { Color = color or Color3.fromRGB(30,30,30), Thickness = thickness or 1, Parent = parent })
end

local function MakeDraggable(handle, frame)
    if not handle or not frame then return end
    local isDragging, dragInput, dragStartPosition, startPosition = false, nil, nil, nil
    SafeConnect(handle.InputBegan, function(input)
        if not input then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStartPosition = input.Position
            startPosition = frame.Position
            SafeConnect(input.Changed, function()
                if input.UserInputState == Enum.UserInputState.End then isDragging = false end
            end)
        end
    end)
    SafeConnect(handle.InputChanged, function(input)
        if not input then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    SafeConnect(UserInputService.InputChanged, function(input)
        if not isDragging or not dragInput or input ~= dragInput then return end
        if not dragStartPosition or not startPosition then return end
        local delta = input.Position - dragStartPosition
        local newPos = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
        Tween(frame, 0.1, { Position = newPos })
    end)
end

