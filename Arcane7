        pcall(function() NotificationGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
    end

    NotificationHolder = SafeNew("Frame", {
        Name = "NotificationHolder",
        Size = UDim2.new(0, 300, 1, -40),
        Position = UDim2.new(1, -310, 0, 20),
        BackgroundTransparency = 1,
        Parent = NotificationGui,
    })

    if NotificationHolder then
        SafeNew("UIListLayout", {
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = NotificationHolder,
        })
    end
end
SafeCall(SetupNotifications)

function Library:Notify(title, text, duration, notificationType)
    if not NotificationHolder then return end
    duration = tonumber(duration) or 3
    if duration ~= duration or duration <= 0 then duration = 3 end
    notificationType = notificationType or "Info"

    local soundId = NotificationSounds[notificationType]
    if soundId then
        SafeCall(function()
            local sound = SafeNew("Sound", {
                SoundId = soundId,
                Volume = 0.5,
                Parent = NotificationGui or CoreGui,
            })
            if sound then
                pcall(function() sound:Play() end)
                task.delay(math.max(1, tonumber(sound.TimeLength) or 2), function()
                    pcall(function() sound:Destroy() end)
                end)
            end
        end)
    end

    local colors = {
        Info = Theme.Accent, Success = Theme.Success,
        Warning = Theme.Warning, Error = Theme.Error,
    }

    local notification = SafeNew("Frame", {
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = Theme.Section,
        Parent = NotificationHolder,
    })
    if not notification then return end

    AddCorner(notification, 8)
    AddStroke(notification, Theme.Border)

    local accentBar = SafeNew("Frame", {
        Size = UDim2.new(0, 4, 1, -10),
        Position = UDim2.new(0, 5, 0, 5),
        BackgroundColor3 = colors[notificationType] or Theme.Accent,
        BorderSizePixel = 0,
        Parent = notification,
    })
    AddCorner(accentBar, 2)

    SafeNew("TextLabel", {
        Size = UDim2.new(1, -50, 0, 22),
        Position = UDim2.new(0, 18, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(title or "Notificação"),
        TextColor3 = Theme.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notification,
    })

    SafeNew("TextLabel", {
        Size = UDim2.new(1, -25, 0, 32),
        Position = UDim2.new(0, 18, 0, 30),
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = Theme.TextDark,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Parent = notification,
    })

    local progressBar = SafeNew("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = colors[notificationType] or Theme.Accent,
        BorderSizePixel = 0,
        Parent = notification,
    })

    notification.Position = UDim2.new(1, 20, 0, 0)
    Tween(notification, 0.3, { Position = UDim2.new(0, 0, 0, 0) })
    if progressBar then
        Tween(progressBar, duration, { Size = UDim2.new(0, 0, 0, 3) })
    end

    task.delay(duration, function()
        SafeCall(function()
            if notification and notification.Parent then
                Tween(notification, 0.3, { Position = UDim2.new(1, 20, 0, 0) })
                task.wait(0.35)
                pcall(function() notification:Destroy() end)
            end
        end)
    end)
end

