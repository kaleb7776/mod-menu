local ColorRegistry = {}
local ThemeRefreshers = {}
local ControlRegistry = {}
local CONFIG_FOLDER = "RavionUI/Configs"
local HAS_FILE = writefile ~= nil and readfile ~= nil and listfiles ~= nil
    and isfolder ~= nil and makefolder ~= nil

local function SetColor(inst, prop, themeKey)
    if not inst or not themeKey then return end
    pcall(function() inst[prop] = Theme[themeKey] end)
    table.insert(ColorRegistry, { inst = inst, prop = prop, key = themeKey })
end
local function RegisterThemeRefresh(fn)
    if type(fn) == "function" then table.insert(ThemeRefreshers, fn) end
end
local function RegisterControl(flag, setter)
    if flag and type(setter) == "function" then ControlRegistry[flag] = setter end
end

local function EnsureFolder()
    if not HAS_FILE then return false end
    if not isfolder("RavionUI") then pcall(makefolder, "RavionUI") end
    if not isfolder(CONFIG_FOLDER) then pcall(makefolder, CONFIG_FOLDER) end
    return true
end

local function Serialize(v)
    local t = typeof(v)
    if t == "Color3"  then return { __type="Color3", r=v.R, g=v.G, b=v.B } end
    if t == "Vector3" then return { __type="Vector3", x=v.X, y=v.Y, z=v.Z } end
    if t == "Vector2" then return { __type="Vector2", x=v.X, y=v.Y } end
    if t == "UDim2"   then return { __type="UDim2", xs=v.X.Scale, xo=v.X.Offset, ys=v.Y.Scale, yo=v.Y.Offset } end
    if t == "EnumItem" then return { __type="Enum", enum=tostring(v) } end
    return v
end

local function Deserialize(v)
    if type(v) ~= "table" then return v end
    if v.__type == "Color3"  then return Color3.new(v.r, v.g, v.b) end
    if v.__type == "Vector3" then return Vector3.new(v.x, v.y, v.z) end
    if v.__type == "Vector2" then return Vector2.new(v.x, v.y) end
    if v.__type == "UDim2"   then return UDim2.new(v.xs, v.xo, v.ys, v.yo) end
    if v.__type == "Enum" then
        local ok, en = pcall(function()
            local parts = string.split(v.enum, ".")
            return Enum[parts[1]][parts[2]]
        end)
        if ok then return en end
    end
    return v
end

