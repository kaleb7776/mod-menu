        TextColor3 = Color3.new(1, 1, 1), TextSize = 14,
        Font = Enum.Font.GothamBold, ZIndex = 1001, Parent = dialog,
    })
    AddCorner(noBtn, 8)

    SafeConnect(yesBtn.MouseEnter, function() Tween(yesBtn, 0.15, { BackgroundColor3 = Theme.Success:Lerp(Color3.new(1,1,1), 0.2) }) end)
    SafeConnect(yesBtn.MouseLeave, function() Tween(yesBtn, 0.15, { BackgroundColor3 = Theme.Success }) end)
    SafeConnect(noBtn.MouseEnter,  function() Tween(noBtn, 0.15, { BackgroundColor3 = Theme.Error:Lerp(Color3.new(1,1,1), 0.2) }) end)
    SafeConnect(noBtn.MouseLeave,  function() Tween(noBtn, 0.15, { BackgroundColor3 = Theme.Error }) end)

    SafeConnect(yesBtn.MouseButton1Click, function()
        pcall(function() overlay:Destroy() end)
        SafeCall(callback, true)
    end)
    SafeConnect(noBtn.MouseButton1Click, function()
        pcall(function() overlay:Destroy() end)
        SafeCall(callback, false)
    end)

    SafeConnect(overlay.InputBegan, function(input)
        if not input then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 and input.Target == overlay then
            pcall(function() overlay:Destroy() end)
            SafeCall(callback, false)
        end
    end)
end

