        local tabPage = Create("ScrollingFrame", { Name = "\0", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), Visible = false, Parent = contentArea })
        if not tabPage then return nil end
        
        local pageLayout = Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabPage })
        Create("UIPadding", { PaddingTop = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), Parent = tabPage })
        
        if pageLayout then
