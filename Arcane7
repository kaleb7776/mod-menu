            function sectionObject:AddSlider(text, minimum, maximum, defaultValue, flag, callback)
                minimum = tonumber(minimum) or 0
                maximum = tonumber(maximum) or 100
                if maximum < minimum then minimum, maximum = maximum, minimum end
                defaultValue = tonumber(defaultValue) or minimum
                callback = callback or function() end
                local value = SafeClamp(math.floor(defaultValue + 0.5), minimum, maximum)
                local range = maximum - minimum
                local sf = SafeNew("Frame", {
                    Name = "Slider", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = contentContainer,
                })
                if not sf then return nil end
                SafeNew("TextLabel", {
                    Name = "Label", Size = UDim2.new(0.6, 0, 0, 18), BackgroundTransparency = 1,
                    Text = tostring(text or "Slider"), TextColor3 = Theme.Text, TextSize = 12,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = sf,
                })
                local vl = SafeNew("TextLabel", {
                    Name = "Value", Size = UDim2.new(0.4, 0, 0, 18), Position = UDim2.new(0.6, 0, 0, 0),
                    BackgroundTransparency = 1, Text = tostring(value), TextColor3 = Theme.Accent,
                    TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, Parent = sf,
                })
                local bg = SafeNew("Frame", {
                    Name = "Background", Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 24),
                    BackgroundColor3 = Theme.SliderBg, BorderSizePixel = 0, Parent = sf,
                })
                AddCorner(bg, 5)
                local ratio = SafeDivide(value - minimum, range, 0)
                local fill = SafeNew("Frame", {
                    Name = "Fill", Size = UDim2.new(ratio, 0, 1, 0), BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0, Parent = bg,
                })
                AddCorner(fill, 5); SetColor(fill, "BackgroundColor3", "Accent")
                local sbtn = SafeNew("TextButton", {
                    Name = "Button", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = bg,
                })
                local function SetValue(v)
                    v = tonumber(v) or minimum
                    value = SafeClamp(math.floor(v + 0.5), minimum, maximum)
                    local nr = SafeDivide(value - minimum, range, 0)
                    Tween(fill, 0.1, { Size = UDim2.new(nr, 0, 1, 0) })
                    pcall(function() vl.Text = tostring(value) end)
                    if flag then Library.Flags[flag] = value end
                    SafeCall(callback, value)
                end
                local isDragging = false
                local function UpdateSlider(input)
                    if not bg or not input then return end
                    local pos = SafeDivide(input.Position.X - bg.AbsolutePosition.X, bg.AbsoluteSize.X, 0)
                    SetValue(minimum + SafeClamp(pos, 0, 1) * range)
                end
                SafeConnect(sbtn.InputBegan, function(input)
                    if not input then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true; UpdateSlider(input)
                    end
                end)
                SafeConnect(UserInputService.InputChanged, function(input)
                    if isDragging and input and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then UpdateSlider(input) end
                end)
                SafeConnect(UserInputService.InputEnded, function(input)
                    if input and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then isDragging = false end
                end)
                if flag then Library.Flags[flag] = value end
                local o = {}
                function o:Set(v) SetValue(v) end
                function o:Get() return value end
                RegisterControl(flag, function(v) SetValue(v) end)
                return o
            end

