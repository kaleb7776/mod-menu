            local sectionFrame = Create("Frame", { Name = "\0", Size = UDim2.new(1, -5, 0, 35), BackgroundColor3 = Theme.Section, BorderSizePixel = 0, Parent = tabPage })
            if not sectionFrame then return nil end
            AddCorner(sectionFrame, 8); AddStroke(sectionFrame, Theme.Border)
            
