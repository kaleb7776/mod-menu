                        SafeCall(function()
                            Library.Open = false
                            if mainFrame then mainFrame.Visible = false end
                            if IsMobile and mobileButton then mobileButton.Visible = false end
                            if Library._Footer then Library._Footer.Visible = false end
                            if screenGui then screenGui:Destroy() end
                            if NotificationGui then NotificationGui:Destroy() end
                        end)
                        Library.Flags = {}
                        Library._ScreenGui = nil
                        Library._MainFrame = nil
                        Library._MobileButton = nil
                        Library._Footer = nil
